# DukaPulse Environment Variables Template
# Copy to .env and populate with your cloud credentials. Never commit .env to version control.

# Tiger Data / Timescale Cloud primary connection string
# Shape: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://tsdbadmin:your_password_here@your-instance.tsdb.cloud.timescale.com:30445/tsdb?sslmode=require

# Hugging Face User Access Token (Write permissions for Space deployment)
# Generate from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_write_token_here
